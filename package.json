{
  "name": "educart",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=high",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "audit:bundle": "node scripts/verificar-escopo-dependencias.mjs",
    "test:homologacao": "node scripts/homologacao-completa.mjs",
    "test:homologacao:preflight": "node --test scripts/homologacao-preflight.test.mjs",
    "backup:record": "node scripts/verificar-backup-operacional.mjs record",
    "backup:verify": "node scripts/verificar-backup-operacional.mjs verify",
    "test:backup": "node --test scripts/verificar-backup-operacional.test.mjs",
    "monitor:check": "node scripts/monitorar-operacao.mjs",
    "test:monitor": "node --test scripts/monitorar-operacao.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.80.0",
    "@tanstack/react-query": "5.90.2",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7",
    "zustand": "5.0.8",
    "read-excel-file": "9.3.14",
    "jspdf": "4.2.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.14",
    "@types/node": "24.8.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.1",
    "@types/three": "0.180.0"
  }
}
